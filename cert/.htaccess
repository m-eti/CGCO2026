Options -Indexes

<FilesMatch "\.(xlsx|xls|csv|json|lock|env|log|zip)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# دسترسی مستقیم به فایل مقالات (articles.zip) مسدود است؛
# ارائه فایل تنها از طریق download-articles.php و پس از احراز هویت انجام می‌شود.
<Files "articles.zip">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

AddDefaultCharset UTF-8

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    
    <FilesMatch "\.(ttf|otf|woff|woff2|png|jpg|jpeg)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>