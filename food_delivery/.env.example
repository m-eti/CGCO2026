# Food Delivery System - production configuration
# Copy this file to ".env" and adjust the values. The .env file must never be
# exposed over the web (the bundled .htaccess already blocks dotfiles).
# Lines starting with # are comments; keep comments on their own line.

# --- Admin account (change these before going live) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_NAME=مدیر سیستم

# --- QR code signing secret ---
# Leave empty to use the random secret stored in the database.
# Set a fixed value only if you need the same secret on every server;
# changing it invalidates the cards that were already printed.
HMAC_SECRET=

# --- Session lifetime (seconds) ---
SESSION_IDLE_TIMEOUT=7200
SESSION_ABSOLUTE_TIMEOUT=28800

# --- Login attempt limits ---
LOGIN_FAIL_LIMIT=5
LOGIN_FAIL_WINDOW=900
LOGIN_LOCK_TIME=900
IP_FAIL_LIMIT=30

# --- Scanner limits ---
SCAN_LIMIT=45
SCAN_WINDOW=60

# --- Uploads and password policy ---
MAX_UPLOAD_BYTES=2097152
MIN_PASSWORD_LENGTH=5
MIN_STAFF_PASSWORD_LENGTH=6

# --- Storage ---
# Relative paths are resolved inside the application folder.
DB_FILE=food_delivery.sqlite

# --- Interface ---
APP_TITLE=سامانه مدیریت تحویل غذا
